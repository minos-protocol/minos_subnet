# Minos Miner Configuration
# Copy to .env: cp .env.miner.example .env

# Bittensor
NETUID=107
WALLET_NAME=default
WALLET_HOTKEY=default

# Demo mode: set to true to route the miner to the platform's /v2/demo/*
# sandbox instead of the live endpoints. Uses an ephemeral keypair and
# skips the on-chain registration / metagraph entirely — useful for new
# operators to verify their pipeline before bonding TAO. WALLET_* lines
# above are ignored in this mode.
# MINER_DEMO=true

# Variant Calling Template
# Options: gatk, deepvariant, bcftools
# (freebayes deprecated 2026-05-09 16:00 UTC — submissions rejected by platform)
# All require Docker. Images are pulled automatically.
MINER_TEMPLATE=gatk

# Platform
PLATFORM_URL=https://api.theminos.ai
PLATFORM_TIMEOUT=60

# Storage backend: hippius = Hippius SN75 first (fallback S3), aws_s3 = S3 first
STORAGE_PRIMARY_BACKEND=hippius

# ---------------------------------------------------------------------------
# Spending controls (paid resubmission)
# This miner spends NOTHING unless you opt in below. The platform decides
# whether a submission past a round's free allowance costs TAO and how much;
# the ceilings here bound what it can spend once you have. All are commented
# out below, showing the value that applies when unset.
# Details: docs/miner_features.md
# ---------------------------------------------------------------------------

# Opt IN to paying for resubmissions. Unset means never spend, whatever the
# platform advertises. Accepts 1, true, yes, on.
# MINER_PAY_FOR_RESUBMISSIONS=1

# Refuse to pay anywhere except this address. Unset means "accept whatever the
# platform advertises". Pinning is the stronger setting for an unattended miner:
# the fee and address arrive over HTTPS but are not themselves signed.
# MINOS_EXPECTED_PAYMENT_ADDRESS=

# Hard per-submission ceiling, in TAO. Default 0.01. A fee above it — including
# a price quoted by the platform for this hotkey — is refused outright, not
# clamped: the miner skips that submission rather than underpaying.
# MINOS_MAX_RESUBMISSION_FEE_TAO=0.01

# Hard ceiling on total resubmission spend per HOTKEY over a rolling 24 hours,
# in TAO. Default 0.05, checked against payments that actually completed.
# MINOS_MAX_DAILY_RESUBMISSION_TAO=0.05

# Hard ceiling on total resubmission spend by ALL hotkeys sharing this host's
# ledger over a rolling 24 hours, in TAO. Default 0.10. Without it, running K
# hotkeys on one host multiplies the per-hotkey ceiling above by K.
# MINOS_MAX_DAILY_WALLET_TAO=0.10

# Where payments are recorded. Default ~/.minos/submission_payments.jsonl,
# created 0600 and fsynced before each transfer. An unspent proof here is
# reused instead of paying twice, so keep it on durable local storage.
# Use an absolute path: the value is taken literally, with no ~ expansion.
# MINOS_PAYMENT_LEDGER=/var/lib/minos/submission_payments.jsonl

# Honour an advertised allowance of ZERO free submissions, which would charge a
# fee for a round's FIRST submission. Off by default — the miner logs the
# discrepancy and uses one free submission. Accepts 1, true, yes.
# MINER_ALLOW_ZERO_FREE_SUBMISSIONS=1

# ---------------------------------------------------------------------------
# Commitments and local state
# ---------------------------------------------------------------------------

# Where config commitments and their nonces are recorded. Default
# ~/.minos/commitments.jsonl, created 0600. Written before a commitment is
# published anywhere; if that write fails, no commitment is published. Back it
# up — it is your copy of what you sent. Absolute path, no ~ expansion.
# MINOS_COMMITMENT_LEDGER=/var/lib/minos/commitments.jsonl

# Where the scoring-formula version last seen from the platform is remembered.
# Default ~/.minos/scoring_version.json. --practice records the version the
# platform advertises; the offline --score path reads it back, and falls back
# to v1 on a machine that has never reached the platform. No ~ expansion.
# MINOS_SCORING_VERSION_STATE=/var/lib/minos/scoring_version.json

# Reject a downloaded file whose SHA-256 does not match the digest the platform
# published for it. OFF by default: a mismatch on a freshly downloaded file is
# logged as a warning and the file is used anyway. (A *cached* file that does
# not match is always discarded and re-downloaded.) Accepts 1, true, yes, on.
# MINOS_ENFORCE_DOWNLOAD_SHA256=1
